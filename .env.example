# Copy this file to .env before running docker compose up --build
# These are dummy values for the local postgres container only.
# The real Neon connection string is never committed, it lives in Render's environment settings.

POSTGRES_USER=foodbridge
POSTGRES_PASSWORD=local_dev_only
POSTGRES_DB=foodbridge

# ports on your machine. web is http://localhost:5000 and swagger is http://localhost:5001/swagger
WEB_PORT=5000
API_PORT=5001
