@model FoodListing
@{
    ViewData["Title"] = "Post surplus food";
}

<h2>Post surplus food</h2>
<p class="text-muted">Tell nearby NGOs what you have and when it needs to be picked up by.</p>

<div class="row">
    <div class="col-md-7">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Title" class="form-label">What food is it?</label>
                <input asp-for="Title" class="form-control" placeholder="e.g. Day old bread" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Quantity" class="form-label"></label>
                <input asp-for="Quantity" class="form-control" placeholder="e.g. 20 loaves" />
                <span asp-validation-for="Quantity" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">Notes (optional)</label>
                <textarea asp-for="Description" class="form-control" rows="2" placeholder="Allergens, storage, packaging..."></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="DonorName" class="form-label">Your business name</label>
                <input asp-for="DonorName" class="form-control" />
                <span asp-validation-for="DonorName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PickupAddress" class="form-label"></label>
                <input asp-for="PickupAddress" class="form-control" />
                <span asp-validation-for="PickupAddress" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="CollectBy" class="form-label"></label>
                <input asp-for="CollectBy" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" type="datetime-local" />
                <span asp-validation-for="CollectBy" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-success">Post listing</button>
            <a asp-action="Index" class="btn btn-link">Cancel</a>
        </form>
    </div>
</div>
